{
  "skillListingBudgetFraction": 0.01,
  "maxSkillDescriptionChars": 1024,
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80"
  },
  "permissions": {
    "ask": [
      "Bash(rm *)",
      "Bash(chmod *)",
      "Bash(npm *)",
      "Bash(docker *)",
      "Bash(kill *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/design-stop-hook.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
