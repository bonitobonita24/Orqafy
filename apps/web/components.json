{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "tailwind.config.ts",
    "css": "src/app/globals.css",
    "baseColor": "zinc",
    "cssVariables": true,
    "prefix": ""
  },
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "iconLibrary": "hugeicons",
  "registries": {
    "@shadcn-studio": {
      "url": "https://shadcnstudio.com/r/new-york-v4/{name}.json",
      "headers": {
        "x-license-key": "${SHADCNSTUDIO_API_KEY}",
        "x-email": "${SHADCNSTUDIO_EMAIL}"
      }
    }
  }
}
