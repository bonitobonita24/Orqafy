{
  "name": "@orqafy/db",
  "version": "0.14.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "prisma"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./middleware/tenant-guard": {
      "types": "./dist/middleware/tenant-guard.d.ts",
      "default": "./dist/middleware/tenant-guard.js"
    },
    "./helpers/audit": {
      "types": "./dist/helpers/audit.d.ts",
      "default": "./dist/helpers/audit.js"
    },
    "./helpers/tenant-schema": {
      "types": "./dist/helpers/tenant-schema.d.ts",
      "default": "./dist/helpers/tenant-schema.js"
    }
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/seed/index.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --project tsconfig.build.json",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@orqafy/shared": "workspace:*",
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.6.0",
    "prisma": "^6.6.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0"
  }
}
