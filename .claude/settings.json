{
  "skillListingBudgetFraction": 0.01,
  "maxSkillDescriptionChars": 1024,
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80"
  },
  "permissions": {
    "ask": [
      "Bash(chmod *)",
      "Bash(docker *)",
      "Bash(kill *)",
      "Bash(npm *)",
      "Bash(rm *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/design-stop-hook.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "contextFiles": [
    ".cline/memory/lessons.md",
    "docs/PRODUCT.md",
    "inputs.yml",
    "inputs.schema.json",
    "docs/CHANGELOG_AI.md",
    "docs/DECISIONS_LOG.md",
    "docs/IMPLEMENTATION_MAP.md",
    "project.memory.md",
    ".cline/memory/agent-log.md"
  ]
}
