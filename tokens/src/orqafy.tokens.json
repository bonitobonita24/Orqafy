{
  "$schema": "https://schemas.tokens.studio/v4/schemas/tokens.json",
  "$metadata": {
    "theme": "neutral-dark",
    "app": "Orqafy",
    "canonical": true,
    "source": "apps/web/src/app/globals.css :root block",
    "updated": "2026-06-18",
    "note": "DTCG-format design tokens for Orqafy neutral-dark theme. Values mirror CSS variables in globals.css — globals.css is the source of truth for deployed values; this file is the design-contract source for validation."
  },

  "color": {
    "$type": "color",

    "background": {
      "$value": "hsl(0 0% 3.9%)",
      "$description": "Page canvas, card, popover background. --background / --card / --popover"
    },
    "foreground": {
      "$value": "hsl(0 0% 98%)",
      "$description": "Primary text on dark surfaces. --foreground / --card-foreground / --popover-foreground"
    },

    "primary": {
      "$value": "hsl(0 0% 98%)",
      "$description": "Near-white primary interactive color (filled buttons, active chips). --primary"
    },
    "primary-foreground": {
      "$value": "hsl(0 0% 9%)",
      "$description": "Near-black text on primary surfaces. --primary-foreground"
    },

    "secondary": {
      "$value": "hsl(0 0% 14.9%)",
      "$description": "Mid-gray secondary surfaces. --secondary"
    },
    "secondary-foreground": {
      "$value": "hsl(0 0% 98%)",
      "$description": "--secondary-foreground"
    },

    "muted": {
      "$value": "hsl(0 0% 14.9%)",
      "$description": "Muted surfaces. --muted"
    },
    "muted-foreground": {
      "$value": "hsl(0 0% 63.9%)",
      "$description": "De-emphasized text (descriptions, metadata). --muted-foreground"
    },

    "accent": {
      "$value": "hsl(0 0% 14.9%)",
      "$description": "Accent surfaces. --accent"
    },
    "accent-foreground": {
      "$value": "hsl(0 0% 98%)",
      "$description": "--accent-foreground"
    },

    "destructive": {
      "$value": "hsl(0 62.8% 30.6%)",
      "$description": "Dark red for destructive variant. --destructive"
    },
    "destructive-foreground": {
      "$value": "hsl(0 0% 98%)",
      "$description": "--destructive-foreground"
    },

    "border": {
      "$value": "hsl(0 0% 14.9%)",
      "$description": "Standard border color. --border"
    },
    "input": {
      "$value": "hsl(0 0% 14.9%)",
      "$description": "Input border. --input"
    },
    "ring": {
      "$value": "hsl(0 0% 83.1%)",
      "$description": "Focus rings and signal-glow animation. --ring"
    },

    "brand-muted": {
      "$value": "hsl(0 0% 14.9%)",
      "$description": "Extended alias for muted brand surfaces (bg-brand-muted). --brand-muted"
    },
    "surface": {
      "$value": "hsl(0 0% 14.9%)",
      "$description": "Extended alias for elevated surfaces (bg-surface). --surface"
    },

    "sidebar-background": {
      "$value": "hsl(0 0% 3.9%)",
      "$description": "--sidebar-background"
    },
    "sidebar-foreground": {
      "$value": "hsl(0 0% 98%)",
      "$description": "--sidebar-foreground"
    },
    "sidebar-primary": {
      "$value": "hsl(0 0% 98%)",
      "$description": "--sidebar-primary"
    },
    "sidebar-primary-foreground": {
      "$value": "hsl(0 0% 9%)",
      "$description": "--sidebar-primary-foreground"
    },
    "sidebar-accent": {
      "$value": "hsl(0 0% 14.9%)",
      "$description": "--sidebar-accent"
    },
    "sidebar-accent-foreground": {
      "$value": "hsl(0 0% 98%)",
      "$description": "--sidebar-accent-foreground"
    },
    "sidebar-border": {
      "$value": "hsl(0 0% 14.9%)",
      "$description": "--sidebar-border"
    },
    "sidebar-ring": {
      "$value": "hsl(0 0% 83.1%)",
      "$description": "--sidebar-ring"
    },

    "chart-1": { "$value": "hsl(220 70% 50%)", "$description": "--chart-1" },
    "chart-2": { "$value": "hsl(160 60% 45%)", "$description": "--chart-2" },
    "chart-3": { "$value": "hsl(30 80% 55%)",  "$description": "--chart-3" },
    "chart-4": { "$value": "hsl(280 65% 60%)", "$description": "--chart-4" },
    "chart-5": { "$value": "hsl(340 75% 55%)", "$description": "--chart-5" }
  },

  "borderRadius": {
    "$type": "dimension",
    "base":   { "$value": "0.5rem",  "$description": "Base radius (--radius). Maps to rounded-lg." },
    "md":     { "$value": "0.375rem","$description": "calc(--radius - 2px). Maps to rounded-md (buttons, inputs)." },
    "sm":     { "$value": "0.25rem", "$description": "calc(--radius - 4px). Maps to rounded-sm (small elements)." },
    "pill":   { "$value": "9999px",  "$description": "Pill shape for tags, badges, status chips." }
  },

  "typography": {
    "fontFamily": {
      "heading": {
        "$type": "fontFamily",
        "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "Ubuntu", "Cantarell", "Noto Sans", "Helvetica", "Arial", "sans-serif"],
        "$description": "h1/h2/h3 headings — native OS authority."
      },
      "body": {
        "$type": "fontFamily",
        "$value": ["var(--font-inter)", "Inter", "system-ui", "sans-serif"],
        "$description": "Body / UI text — loaded via next/font/google as --font-inter."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["SFMono-Regular", "Menlo", "Monaco", "Consolas", "Liberation Mono", "Courier New", "monospace"],
        "$description": "Code blocks, SKUs, refs."
      }
    },
    "scale": {
      "display": {
        "fontSize":      { "$type": "dimension", "$value": "3.75rem",  "$description": "60px" },
        "lineHeight":    { "$type": "number",    "$value": 1,           "$description": "Compressed 1.00" },
        "letterSpacing": { "$type": "dimension", "$value": "-0.65px",  "$description": "Negative compression" },
        "fontWeight":    { "$type": "number",    "$value": 400 }
      },
      "section": {
        "fontSize":      { "$type": "dimension", "$value": "2.25rem",  "$description": "36px" },
        "lineHeight":    { "$type": "number",    "$value": 1.11 },
        "letterSpacing": { "$type": "dimension", "$value": "-0.9px",   "$description": "Tightest in system" },
        "fontWeight":    { "$type": "number",    "$value": 400 }
      },
      "subheading": {
        "fontSize":      { "$type": "dimension", "$value": "1.5rem",   "$description": "24px" },
        "lineHeight":    { "$type": "number",    "$value": 1.33 },
        "letterSpacing": { "$type": "dimension", "$value": "-0.6px" },
        "fontWeight":    { "$type": "number",    "$value": 700,         "$description": "Bold at 24px" }
      },
      "overline": {
        "fontSize":      { "$type": "dimension", "$value": "0.875rem", "$description": "14px" },
        "lineHeight":    { "$type": "number",    "$value": 1.43 },
        "letterSpacing": { "$type": "dimension", "$value": "2.52px",   "$description": "Widest — uppercase required" },
        "fontWeight":    { "$type": "number",    "$value": 600 }
      }
    }
  },

  "animation": {
    "signalGlow": {
      "duration":        { "$type": "duration", "$value": "2500ms" },
      "timingFunction":  { "$type": "cubicBezier", "$value": [0.37, 0, 0.63, 1], "$description": "ease-in-out" },
      "iterationCount":  { "$type": "number",   "$value": -1,        "$description": "infinite (-1 = infinite)" },
      "glowMin":         { "$type": "shadow",   "$value": "drop-shadow(0 0 2px hsl(0 0% 83.1% / 0.6))", "$description": "Start/end keyframe — ring color at 60% opacity" },
      "glowMax":         { "$type": "shadow",   "$value": "drop-shadow(0 0 8px hsl(0 0% 83.1% / 0.9))", "$description": "50% keyframe — ring color at 90% opacity" }
    }
  }
}
