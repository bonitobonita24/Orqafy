# ═══════════════════════════════════════════════════════════════════
# Orqafy — Environment Variables Template
# ═══════════════════════════════════════════════════════════════════
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env.dev   (and .env.staging, .env.prod)
#   2. Fill values from CREDENTIALS.md by running:
#        bash scripts/sync-credentials-to-env.sh
#   3. NEVER commit .env.dev / .env.staging / .env.prod or CREDENTIALS.md to git.
#
# FIRST ADMIN ACCOUNT (created by pnpm db:seed in Phase 6):
#   Username: webmaster
#   Password: see CREDENTIALS.md → "First Admin Account" section
#   URL: http://localhost:[APP_PORT]/login
#
# All AI-generated credentials (DB, Valkey, MinIO, pgAdmin, Auth) live in CREDENTIALS.md.
# Anyone cloning this repo must run Bootstrap Step 18 to generate their own credentials.
# ═══════════════════════════════════════════════════════════════════

# ─── Compose / app identity ─────────────────────────────────────────
COMPOSE_PROJECT_NAME=orqafy_dev
APP_ENV=development
APP_PORT=42951

# ─── PostgreSQL ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=42941
DB_NAME=orqafy_dev
DB_USER=your-db-user-here
DB_PASSWORD=your-db-password-here
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# ─── PgBouncer ──────────────────────────────────────────────────────
PGBOUNCER_PORT=42942
PGBOUNCER_AUTH_PASSWORD=your-pgbouncer-password-here
PGBOUNCER_DATABASE_URL=postgresql://${DB_USER}:${PGBOUNCER_AUTH_PASSWORD}@localhost:${PGBOUNCER_PORT}/${DB_NAME}

# ─── Valkey (cache + BullMQ broker) ─────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=42943
REDIS_PASSWORD=your-valkey-password-here
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# ─── MinIO (S3-compatible file storage) ─────────────────────────────
STORAGE_ENDPOINT=http://localhost:42944
STORAGE_CONSOLE_PORT=42945
STORAGE_BUCKET=orqafy-dev
STORAGE_ACCESS_KEY=your-minio-access-key-here
STORAGE_SECRET_KEY=your-minio-secret-key-here
STORAGE_REGION=us-east-1

# ─── Persistent media storage backend (media-storage-default.md) ────
# Fleet default = telegram for dev + staging + prod; demo stays on MinIO.
# MinIO/S3 is RETAINED everywhere as the temp/index/scratch fallback.
# Values: "telegram" | "s3" (== minio) | "minio". Leave as s3 until the Telegram
# bot token + dedicated dev channel below are provisioned, then flip to telegram.
STORAGE_BACKEND=s3
# Telegram bot creds — REAL VALUES LIVE ONLY IN Server-Setups (SOPS+age),
#   Server-Setups/<Server>/secrets/orqafy-<env>-app.enc.env — NEVER hardcode here.
# Dev MUST use its OWN dedicated private channel (same bot) so dummy dev uploads
# never pollute the shared staging/prod media channel.
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
# TELEGRAM_DEFAULT_CHANNEL_ID=-100xxxxxxxxxx   # dedicated Orqafy dev channel id

# ─── Auth.js v5 ─────────────────────────────────────────────────────
AUTH_SECRET=your-48-char-auth-secret-here
NEXTAUTH_URL=http://localhost:${APP_PORT}
AUTH_TRUST_HOST=true

# ─── Mobile JWT auth (apps/mobile — /api/auth/mobile/*) ──────────────
# DEDICATED secret — NEVER reuse AUTH_SECRET (see server/auth/mobile-jwt.ts).
# Generate: openssl rand -base64 48
# ⚠ staging/prod values are OWNER-GATED — see deploy-discipline.md; this repo
# only ever carries dev's own value in the gitignored .env.dev.
MOBILE_JWT_SECRET=your-48-char-mobile-jwt-secret-here

# ─── Email — dev uses MailHog (no real SMTP needed) ─────────────────
SMTP_HOST=localhost
SMTP_PORT=42946
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=dev@localhost
SMTP_FROM_NAME=Orqafy Dev

# ─── pgAdmin ────────────────────────────────────────────────────────
PGADMIN_PORT=42948
PGADMIN_EMAIL=your-pgadmin-email-here
PGADMIN_PASSWORD=your-pgadmin-password-here

# ─── Worker / Studio (dev only) ─────────────────────────────────────
WORKER_PORT=42952
STUDIO_PORT=42961

# ─── Docker Hub image (for staging/prod compose; dev builds locally) ─
DOCKERHUB_USERNAME=bonitobonita24
IMAGE_NAME=orqafy
WORKER_IMAGE_NAME=orqafy-worker
APP_IMAGE_TAG=dev-latest

# ─── Traefik (staging/prod only — leave blank for dev) ──────────────
TRAEFIK_NETWORK=
APP_DOMAIN=

# ─── Xendit (PLATFORM scope — for tenant subscription billing) ──────
# Dev uses TEST keys; staging/prod use LIVE keys (see CREDENTIALS.md)
XENDIT_SECRET_KEY=
XENDIT_PUBLIC_KEY=
XENDIT_WEBHOOK_TOKEN=

# ─── Cloudflare Turnstile (bot protection — framework default) ──────
# Dev + staging use Cloudflare's official test keys (always pass).
# Prod uses real keys from dash.cloudflare.com → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ─── Mobile-web app-download interstitial (OPTIONAL) ────────────────
# Shown as a dismissible full-screen prompt to mobile-web visitors only.
# Leave unset (or "#") until the native apps are published — the
# interstitial falls back to a "coming soon" state instead of a dead link.
NEXT_PUBLIC_ANDROID_APP_URL=
NEXT_PUBLIC_IOS_APP_URL=

# ─── Komodo (deployment manager — staging/prod only) ────────────────
KOMODO_UI_URL=
