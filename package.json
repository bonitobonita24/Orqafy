{
  "name": "orqafy",
  "version": "0.18.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "db:generate": "turbo run db:generate --filter=@orqafy/db",
    "db:migrate": "turbo run db:migrate --filter=@orqafy/db",
    "db:seed": "turbo run db:seed --filter=@orqafy/db",
    "db:reset": "turbo run db:reset --filter=@orqafy/db",
    "db:studio": "turbo run db:studio --filter=@orqafy/db",
    "tools:validate-inputs": "node tools/validate-inputs.mjs",
    "tools:check-env": "node tools/check-env.mjs",
    "tools:check-product-sync": "node tools/check-product-sync.mjs",
    "tools:hydration-lint": "node tools/hydration-lint.mjs",
    "preflight": "node tools/preflight-context.mjs",
    "preflight:test": "node tools/preflight-context.mjs --self-test",
    "design:validate": "node scripts/design-validate.mjs",
    "design:build": "node scripts/design-validate.mjs && node scripts/design-build.mjs",
    "design:check": "node scripts/design-check.mjs",
    "design:check:update": "node scripts/design-check.mjs -- --update-snapshots"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ],
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "@auth/core": ">=0.41.3",
      "tar": "^7.5.19",
      "@xmldom/xmldom": "^0.8.13",
      "fast-uri": "^3.1.5",
      "ws": "^8.20.1",
      "uuid": "^11.1.1",
      "postcss": "^8.5.23",
      "brace-expansion": "^5.0.9",
      "fast-xml-builder": "^1.1.7",
      "@babel/runtime": "^7.26.10",
      "shell-quote": ">=1.9.0",
      "esbuild": ">=0.28.1",
      "picomatch": ">=4.0.4",
      "vite": "7.3.5",
      "form-data": ">=3.0.5",
      "ioredis": "5.11.1",
      "undici": ">=7.29.0 <8",
      "nodemailer": ">=9.0.1",
      "nanoid": "^3.3.17",
      "js-yaml": "^4.3.1",
      "dompurify": "^3.4.13",
      "sharp": ">=0.35.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-5p2g-fcmc-qvqq"
      ]
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "lefthook": "^2.1.9",
    "playwright": "^1.62.1",
    "prettier": "^3.5.3",
    "turbo": "^2.9.14",
    "typescript": "^5.8.3"
  }
}
